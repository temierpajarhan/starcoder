{
  "name": "pendle-flooping-mainnet",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "build": "hardhat compile",
    "deploy": "hardhat run scripts/deploy.hardhat.ts --network arbitrum",
    "simulate": "ts-node scripts/simulate.ts",
    "runOnce": "ts-node scripts/runOnce.ts",
    "runAndMeasure": "ts-node --esm scripts/runAndMeasure.ts",
